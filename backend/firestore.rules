rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) { return request.auth != null && request.auth.uid == uid; }
    function validPhone(value) {
      return value is string && value.size() <= 30
        && (value.trim().size() == 0 || value.replace('[\\s()+-]', '').matches('[0-9]{9,15}'));
    }
    function validProfile(data) {
      return data.keys().hasAll(['name', 'phone', 'address', 'city', 'job', 'monthlyIncome', 'darkMode', 'notifEnabled', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'phone', 'address', 'city', 'job', 'monthlyIncome', 'darkMode', 'notifEnabled', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.name.trim().size() > 0
        && validPhone(data.phone)
        && data.address is string && data.address.size() <= 500
        && data.city is string && data.city.size() <= 120
        && data.job is string && data.job.size() <= 120
        && data.monthlyIncome is int && data.monthlyIncome >= 0 && data.monthlyIncome <= 9007199254740991
        && data.darkMode is bool && data.notifEnabled is bool
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }
    function validTransaction(data) {
      return data.keys().hasAll(['category', 'description', 'amount', 'isIncome', 'date', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['category', 'description', 'amount', 'isIncome', 'date', 'createdAt', 'updatedAt'])
        && data.category is string && data.category.size() > 0 && data.category.size() <= 120
        && data.category.trim().size() > 0
        && data.description is string && data.description.size() > 0 && data.description.size() <= 1000
        && data.description.trim().size() > 0
        && data.amount is int && data.amount > 0 && data.amount <= 9007199254740991
        && data.isIncome is bool && data.date is timestamp
        && data.date >= timestamp.date(1900, 1, 1) && data.date < timestamp.date(2201, 1, 1)
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }
    match /users/{uid} {
      allow get: if owns(uid);
      allow create: if owns(uid) && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if owns(uid) && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      match /transactions/{id} {
        allow read, delete: if owns(uid);
        allow create: if owns(uid) && validTransaction(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if owns(uid) && validTransaction(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
