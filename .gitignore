android/.gradle/
android/captures/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/

# IDE module files (IntelliJ / Android Studio)
*.iml
!android/gradle/wrapper/gradle-wrapper.jar

# ─── iOS / macOS / Xcode ─────────────────────────────────────────────────────
ios/Flutter/flutter_export_environment.sh
ios/Flutter/Generated.xcconfig
ios/.symlinks/
ios/Pods/
*.xcworkspace/xcuserdata/
DerivedData/
*.moved-aside
*.pyc

# ─── IDE & editor config ─────────────────────────────────────────────────────
.idea/
.vscode/settings.json
.vscode/.ropeproject
*.swp
*.swo
*~

# ─── macOS ───────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
._*

# ─── Windows ─────────────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini

# ─── Logs & temp ─────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*

# ─── Firebase / Google credentials ───────────────────────────────────────────
# Service account private keys — NEVER commit these
*-service-account*.json
service-account*.json
*serviceAccount*.json
firebase-adminsdk*.json
# CLI session / local emulator data
.firebaserc.local
firebase-debug.log
firestore-debug.log
ui-debug.log
database-debug.log
pubsub-debug.log
storage-debug.log
# Note: google-services.json (Android) and GoogleService-Info.plist (iOS)
# are Firebase client config files, NOT secrets. They should be committed
# once generated by FlutterFire CLI during the Firebase setup step (C1/C3).
# Do NOT add google-services.json or GoogleService-Info.plist here.

# ─── Environment / secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example
secrets.json
secrets.yaml

# ─── Backend (future) ────────────────────────────────────────────────────────
backend/node_modules/
backend/.firebase/
backend/functions/node_modules/
backend/functions/lib/
