# ─── Flutter / Dart ──────────────────────────────────────────────────────────
# Dart tool cache
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages

# Flutter build output
build/
.build/

# Flutter native splash generated files (re-generated by tool)
