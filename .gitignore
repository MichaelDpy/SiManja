# ─── Firebase / Google credentials ───────────────────────────────────────────
# Service account private keys — JANGAN di-commit
*-service-account*.json
service-account*.json
*serviceAccount*.json
firebase-adminsdk*.json

# Firebase CLI / emulator debug logs
firebase-debug.log
firestore-debug.log
ui-debug.log
database-debug.log
pubsub-debug.log
storage-debug.log

# Firebase local session
.firebaserc.local

# CATATAN: google-services.json (Android) dan GoogleService-Info.plist (iOS)
# adalah konfigurasi client Firebase, BUKAN secret. Harus di-commit setelah
# FlutterFire CLI dijalankan pada langkah C1/C3.
# JANGAN tambahkan google-services.json atau GoogleService-Info.plist di sini.

# ─── Environment / secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example
secrets.json
secrets.yaml

